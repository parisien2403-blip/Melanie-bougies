// Déploiement Cloudflare (Workers) : le site (dossier public/) + la boutique (worker.js, /api/…).
// Cloudflare le déploie tout seul depuis GitHub à chaque publication. La base D1 est créée automatiquement
// au premier déploiement. Réglage à faire une fois dans Cloudflare : le secret CODE_ATELIER (voir README.md).
{
  "name": "la-madeleine",
  "main": "worker.js",
  // Adresse publique la-madeleine.<compte>.workers.dev toujours active
  "workers_dev": true,
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "la-madeleine" }],
  // Toutes les 30 minutes : une nouvelle version (public/version.json, « notifier » à vrai) est annoncée en notification
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
